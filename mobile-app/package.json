{
  "name": "glowup-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "build": "expo export --platform web",
    "start": "npx --yes --package=node@20 node node_modules/expo/bin/cli start",
    "android": "npx --yes --package=node@20 node node_modules/expo/bin/cli start --android",
    "ios": "npx --yes --package=node@20 node node_modules/expo/bin/cli start --ios",
    "web": "npx --yes --package=node@20 node node_modules/expo/bin/cli start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.2",
    "babel-preset-expo": "~54.0.10",
    "date-fns": "^2.30.0",
    "expo": "^57.0.18",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-vector-icons": "^10.0.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  }
}
